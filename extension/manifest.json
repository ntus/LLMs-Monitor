{
  "manifest_version": 3,
  "default_locale": "ja",
  "name": "__MSG_extensionName__",
  "version": "1.8.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://one.google.com/*",
    "https://status.openai.com/*",
    "https://status.claude.com/*",
    "https://www.google.com/appsstatus/dashboard/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "locale.js",
        "preferences.js",
        "provider-status.js",
        "changes.js",
        "shared.js",
        "advice.js",
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://llmsmonitor.ntusnog.chatgpt.site/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
